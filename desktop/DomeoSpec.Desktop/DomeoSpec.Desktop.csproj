<Project Sdk="Microsoft.NET.Sdk">

  <!-- Десктоп-оболочка: нативное окно (WebView2) + запуск бэкенда (ядро разбора и API)
       как дочерних процессов. В автономной сборке рядом с .exe лежат core/, api/, web/,
       tesseract/, pgsql/; на машине разработки — откат на репозиторий. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Domeo</AssemblyName>
    <RootNamespace>DomeoSpec.Desktop</RootNamespace>
    <ApplicationIcon></ApplicationIcon>
    <!-- Версия приложения = версия релиза (Velopack/GitHub). Поднимать при каждом выпуске
         (или задавать параметром release.ps1 -Version, он переопределяет это значение). -->
    <Version>1.0.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <!-- Разовый перенос старых данных из портативного PostgreSQL в SQLite при первом запуске. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <!-- Авто-обновление с GitHub Releases; версия пакета совпадает с версией vpk CLI. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
