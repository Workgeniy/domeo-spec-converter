{
  "manifest_version": 3,
  "name": "Domeo — цены для спецификации",
  "version": "0.1.0",
  "description": "Читает цены на популярных маркетплейсах на страницах, которые вы открываете, и переносит их в Domeo. Своих запросов к маркетплейсу не делает.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Domeo — цены" },
  "content_scripts": [
    {
      "matches": [
        "*://*.wildberries.ru/*",
        "*://*.ozon.ru/*",
        "*://*.market.yandex.ru/*",
        "*://*.megamarket.ru/*",
        "*://*.vseinstrumenti.ru/*",
        "*://*.lemanapro.ru/*",
        "*://*.leroymerlin.ru/*",
        "*://*.dns-shop.ru/*",
        "*://*.citilink.ru/*",
        "*://*.petrovich.ru/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.wildberries.ru/*",
        "*://*.ozon.ru/*",
        "*://*.market.yandex.ru/*",
        "*://*.megamarket.ru/*",
        "*://*.vseinstrumenti.ru/*",
        "*://*.lemanapro.ru/*",
        "*://*.leroymerlin.ru/*",
        "*://*.dns-shop.ru/*",
        "*://*.citilink.ru/*",
        "*://*.petrovich.ru/*"
      ],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": [
        "*://*.wildberries.ru/*",
        "*://*.ozon.ru/*",
        "*://*.market.yandex.ru/*",
        "*://*.megamarket.ru/*",
        "*://*.vseinstrumenti.ru/*",
        "*://*.lemanapro.ru/*",
        "*://*.leroymerlin.ru/*",
        "*://*.dns-shop.ru/*",
        "*://*.citilink.ru/*",
        "*://*.petrovich.ru/*"
      ]
    }
  ]
}
